# ==============================================================================
# PiGO Framework — Root .htaccess (v13.4 Security Hardened)
# ==============================================================================

DirectoryIndex index.php
Options -Indexes

# =========================================================
# 1. HEADER KEAMANAN HTTP MODERN (DEFENSE-IN-DEPTH)
# =========================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:;"
</IfModule>

# =========================================================
# 2. PEMBLOKIRAN BERKAS SENSITIF & KONFIGURASI
# =========================================================
<FilesMatch "^\.(env|cursorrules|gitignore|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Pemblokiran berkas installer pasca instalasi
<Files "install.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Pemblokiran generik seluruh dump SQL, file backup, log, dan archive di root
<FilesMatch "\.(sql|bak|old|log|rar|zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# =========================================================
# 3. PROTEKSI DIREKTORI SISTEM
# =========================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke folder konfigurasi, migrasi, dan panduan agen
    RewriteRule ^(config|src|migrations|\.agents)/.*$ - [F,L]
</IfModule>
